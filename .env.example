# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Nakamas AI copilot (Φ23): model used by /api/ai/copilot (function calling).
# Without GEMINI_API_KEY the copilot runs on its on-device bilingual engine.
GEMINI_MODEL="gemini-2.5-flash"
AI_RATE_LIMIT_PER_MINUTE="30"
# Optional client-side key — ONLY with VITE_AI_USE_PROXY="false" (exposes the key to browsers; not recommended)
VITE_GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Maps — use either variable name (both are supported)
VITE_GOOGLE_MAPS_PLATFORM_KEY=""
VITE_GOOGLE_MAPS_API_KEY=""

# VITE_TICKETMASTER_API_KEY: Optional. Fetches real events from Ticketmaster Discovery API.
# Get a free key from: https://developer.ticketmaster.com/products-and-docs/apis/getting-started/
# Mapped event ids use prefix "tm_" (see src/lib/runtimeMode.ts); Home pages load via useHomeExternalEvents.
VITE_TICKETMASTER_API_KEY=""

# Optional API base + analytics (CoFounderBay-style production shell)
VITE_API_BASE_URL=""
VITE_ENABLE_ANALYTICS="false"
VITE_AI_USE_PROXY="true"
VITE_WS_URL=""

# Optional Firebase realtime (Firestore chat + auth when configured)
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_FIRESTORE_DB_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# Google OAuth without full Firebase — Google Cloud OAuth 2.0 Web Client ID
# (Google Identity Services / One Tap). Used when Firebase Auth env is absent.
VITE_GOOGLE_OAUTH_CLIENT_ID=""

# Stripe (sandbox or live) — Wallet withdraw/manage opens Checkout when set
VITE_STRIPE_PUBLISHABLE_KEY=""
VITE_STRIPE_CHECKOUT_URL=""

# Live support — Help Center contact (mailto: or https helpdesk URL)
VITE_SUPPORT_EMAIL=""
VITE_SUPPORT_URL=""

# ── Server hardening (server.ts) ────────────────────────────────────────
# Exact cross-origin callers allowed to reach /api and the chat socket
# (comma separated). Same-origin is always allowed; localhost only in dev.
ALLOWED_ORIGINS=""
# Writes to the shared events catalog (POST/PUT /api/events):
# - set EVENTS_WRITE_TOKEN (16+ chars) to require "Authorization: Bearer <token>"
# - or EVENTS_WRITE_MODE="open" to allow anyone (throwaway demos only)
# - otherwise writes are open in development and disabled in production
EVENTS_WRITE_TOKEN=""
EVENTS_WRITE_MODE=""
EVENTS_WRITE_LIMIT_PER_MINUTE="20"
# Model for short text helpers (/api/ai/generate); defaults to GEMINI_MODEL.
GEMINI_TEXT_MODEL=""
# Set when running behind a proxy/CDN so rate limits use the real client IP
# ("true" = one hop, or an Express trust-proxy value).
TRUST_PROXY=""
# ── Server-side identity (server/auth.ts) ───────────────────────────────
# Firebase project whose ID tokens the server verifies (RS256, Google keys).
# Falls back to VITE_FIREBASE_PROJECT_ID. When set:
# - /api/ai/* and the chat socket require a signed-in user
# - event writes need a signed-in, non-guest user, limited to their own
#   events; moderators/admins (custom claims role="moderator"/"admin" or
#   admin=true, set with the Admin SDK) may edit any event
# - EVENTS_WRITE_TOKEN still works for trusted back-office jobs
FIREBASE_PROJECT_ID=""
# "true" keeps AI and chat open to callers without a token (not recommended).
AUTH_OPTIONAL=""
# Login page demo accounts and "Explore as guest". Default: shown, except in a
# production build with Firebase configured. "true"/"false" to force.
VITE_DEMO_LOGIN=""
